# Public runtime configuration. Expo embeds these in the bundle; never add secrets.
# API must be reachable from the physical device, via HTTPS tunnel or LAN.
EXPO_PUBLIC_API_URL=https://YOUR-API-TUNNEL.example
# Optional HTTPS patient website for password-reset email completion, MFA sign-in,
# and released patient records. Native login/signup/bookings work without this URL.
# On a physical phone this URL must be accessible from the phone's browser.
# Do not store credentials, session tokens or private health data in EXPO_PUBLIC_*.
# Password reset cannot complete without a reachable patient web URL.
EXPO_PUBLIC_PATIENT_WEB_URL=https://YOUR-PATIENT-WEB.example

# Optional: HTTPS URL of clinic website, for verification documents and advanced management.
# For Android devices, localhost is not a usable PC web server URL.
EXPO_PUBLIC_CLINIC_WEB_URL=
