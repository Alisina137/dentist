# Public runtime configuration. Expo embeds these in the bundle; never add secrets.
# API must be reachable from the physical device, via HTTPS tunnel or LAN.
EXPO_PUBLIC_API_URL=https://YOUR-API-TUNNEL.example
# Optional: patient account (PH14) website, opened in the browser.
# Never collect account passwords directly in the native app until secure PH16 native auth.
EXPO_PUBLIC_PATIENT_WEB_URL=https://YOUR-PATIENT-WEB.example
