{
  "name": "dandanlink",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,ADMIN,CLINIC -c cyan,magenta,green \"pnpm dev:api\" \"pnpm dev:admin\" \"pnpm dev:clinic\"",
    "dev:api": "node scripts/dev-api-with-ngrok.mjs",
    "dev:api:check": "node scripts/check-mobile-api.mjs",
    "dev:clinic": "pnpm --filter @dandanlink/clinic-web dev",
    "dev:admin": "pnpm --filter @dandanlink/admin-web dev",
    "dev:patient": "pnpm dev:mobile",
    "db:migrate": "pnpm --filter @dandanlink/db migrate",
    "db:generate": "pnpm --filter @dandanlink/db generate",
    "admin:grant": "pnpm --filter @dandanlink/api grant:admin",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "dev:mobile": "pnpm --filter @dandanlink/mobile exec expo start --tunnel --clear --go",
    "dev:patient:web": "pnpm --filter @dandanlink/patient-web dev",
    "dev:ports:sync": "node scripts/sync-dev-ports.mjs",
    "dev:auth:no-email": "node scripts/enable-dev-email-bypass.mjs",
    "qa:clinic": "node scripts/clinic-quality-preflight.mjs",
    "qa:pilot": "node scripts/clinic-pilot-preflight.mjs",
    "qa:pilot:latency": "node scripts/clinic-pilot-latency.mjs",
    "qa:clinic:handoff": "node scripts/clinic-pilot-handoff.mjs",
    "qa:operations": "pnpm exec tsx scripts/phase30-operations-preflight.ts",
    "qa:alerts": "pnpm exec tsx scripts/phase31-alert-preflight.ts",
    "qa:alerts:synthetic": "pnpm exec tsx scripts/phase31-alert-preflight.ts --send-synthetic",
    "qa:mobile:accessibility:init": "node scripts/phase32-device-accessibility-check.mjs --init",
    "qa:mobile:accessibility:verify": "node scripts/phase32-device-accessibility-check.mjs --verify",
    "qa:hardening": "node scripts/phase33-public-safety-smoke.mjs",
    "qa:release:ci": "node scripts/phase34-release-candidate.mjs --ci",
    "qa:release:review": "node scripts/phase34-release-candidate.mjs --review",
    "qa:release:snapshot": "node scripts/phase34-release-candidate.mjs --snapshot"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.6",
    "drizzle-kit": "^0.31.5"
  }
}
