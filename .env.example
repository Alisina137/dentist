# Copy to .env at the repository root. Never commit populated credentials.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dandanlink
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
API_BASE_URL=http://localhost:4000
CLINIC_WEB_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3000
PATIENT_WEB_URL=http://localhost:3002
# Production: configure SMTP; without SMTP local development logs restricted test verification URLs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
# Explicitly authorized local administrative bootstrap, never set on public production servers.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=

# DEVELOPMENT ONLY. Do not send real patient or financial data while this is enabled.
# Account email ownership is NOT verified. Never enable in production.
DEV_SKIP_EMAIL_VERIFICATION=true

# Mobile only: configure EXPO_PUBLIC_API_URL in apps/mobile/.env (not in this root file).
# The Expo Go phone needs a reachable API HTTPS tunnel or LAN IP, not localhost:4000.

# PH19 operator attestations (NOT certificates; keep false until dated, independently verified evidence).
# Pilot release is blocked unless every approval below is true AND PH19_PILOT_RELEASE_ENABLED=true.
PH19_LEGAL_PRIVACY_APPROVED=false
PH19_CLINICAL_REVIEW_APPROVED=false
PH19_HOSTING_SECURITY_APPROVED=false
PH19_BACKUP_RESTORE_APPROVED=false
PH19_PENETRATION_TEST_APPROVED=false
PH19_ACCESS_REVIEW_APPROVED=false
PH19_ALERTS_APPROVED=false
PH19_ACCESSIBILITY_RTL_APPROVED=false
PH19_PILOT_ROSTER_APPROVED=false
PH19_PILOT_RELEASE_ENABLED=false

# Phase30 operations: OPTIONAL local private metadata file from an independently
# scheduled backup/restore verifier. Never put secrets/PHI in the heartbeat.
# Example format: {"schemaVersion":1,"backupCompletedAt":"2026-11-19T00:00:00.000Z","restoreVerifiedAt":"2026-11-01T00:00:00.000Z"}
# Backups older than 26h or restore checks older than 30d create redacted alerts.
# Empty in production means a monitoring alert; it never grants PH19 approval.
DANDANLINK_BACKUP_HEARTBEAT_FILE=
